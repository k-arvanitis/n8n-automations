# --- AI Weekly Digest — config values ---
# The workflow references these as {{ $env.X }}. You can either:
#   A) paste the literal values straight into the workflow nodes (no env vars needed), or
#   B) add these variables to your n8n process's environment (this file lists what each one is).
# Note: API keys / OAuth (OpenAI, Google, Gmail, Slack) are NOT set here — they go in
# n8n's Credentials store via the UI.

# Google Sheets spreadsheet ID — the long string in the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=

# Email address that receives the formatted HTML digest every Monday.
DIGEST_EMAIL_RECIPIENT=

# Slack channel ID (not the #name) for the condensed digest post, e.g. C0123ABCDEF.
# In Slack: right-click the channel → View channel details → ID at the bottom.
SLACK_CHANNEL_ID=

# Timezone the schedule fires in (IANA name), e.g. Europe/Athens, America/New_York.
TIMEZONE=Europe/Athens

# Percentage change versus the prior week that flags a section as an anomaly.
ANOMALY_THRESHOLD=20
