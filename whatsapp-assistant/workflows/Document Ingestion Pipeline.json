      "id": "31c38154-cfe3-49fb-8189-2b0ec8506ae0",
      "name": "Extract Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        -440,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "function toUuid(str) {\n  let h1 = 1779033703, h2 = 3144134277, h3 = 1013904242, h4 = 2773480762;\n  for (let i = 0, k; i < str.length; i++) {\n    k = str.charCodeAt(i);\n    h1 = h2 ^ Math.imul(h1 ^ k, 597399067);\n    h2 = h3 ^ Math.imul(h2 ^ k, 2869860233);\n    h3 = h4 ^ Math.imul(h3 ^ k, 951274213);\n    h4 = h1 ^ Math.imul(h4 ^ k, 2716044179);\n  }\n  h1 = Math.imul(h3 ^ (h1 >>> 18), 597399067);\n  h2 = Math.imul(h4 ^ (h2 >>> 22), 2869860233);\n  h3 = Math.imul(h1 ^ (h3 >>> 17), 951274213);\n  h4 = Math.imul(h2 ^ (h4 >>> 19), 2716044179);\n  h1 ^= (h2 ^ h3 ^ h4); h2 ^= h1; h3 ^= h1; h4 ^= h1;\n  const hex = [h1, h2, h3, h4].map(n => (n >>> 0).toString(16).padStart(8, '0')).join('');\n  return [hex.slice(0,8), hex.slice(8,12), hex.slice(12,16), hex.slice(16,20), hex.slice(20,32)].join('-');\n}\n\n// Process EVERY file in this run, not just the first.\nconst out = [];\nconst items = $input.all();\nlet sources = [];\ntry { sources = $('Is Markdown File?').all(); } catch (e) {}\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const fileName = item.json.name\n    || (sources[i] && sources[i].json && sources[i].json.name)\n    || (item.binary && item.binary.data && item.binary.data.fileName)\n    || 'unknown.md';\n  const text = (item.json.content || '').replace(/\\r\\n/g, '\\n');\n  const lines = text.split('\\n');\n  const sections = [];\n  let current = { heading: 'Introduction', lines: [] };\n  for (const line of lines) {\n    if (/^#{2,3}\\s+/.test(line)) {\n      sections.push(current);\n      current = { heading: line.replace(/^#{2,3}\\s+/, '').trim(), lines: [line] };\n    } else {\n      current.lines.push(line);\n    }\n  }\n  sections.push(current);\n\n  let idx = 0;\n  for (const s of sections) {\n    const body = s.lines.join('\\n').trim();\n    if (body.length < 50) continue;\n    out.push({ json: {\n      text: body,\n      source_file: fileName,\n      heading: s.heading,\n      chunk_index: idx,\n      point_id: toUuid(fileName + '::' + idx),\n    } });\n    idx++;\n  }\n}\nreturn out;\n"
      },
