# n8n
N8N_ENCRYPTION_KEY=your-random-32-char-string
WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app
TIMEZONE=Europe/Athens

# Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=whatsapp-assistant

# Google Drive
GDRIVE_FOLDER_ID=your-google-drive-folder-id

# OpenAI is configured as an n8n credential (embeddings + responses), not here.

# Error alerts (Gmail) - recipient address for the Error Handler workflow.
# The Gmail account that sends is set as an n8n credential, not here.
ALERT_EMAIL=you@example.com

# WhatsApp Business Cloud API - the phone number ID Meta assigns to your sender
# number (Meta dashboard -> WhatsApp -> API Setup). The access token and business
# account ID are configured as n8n credentials, not here.
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
